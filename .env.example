# ─────────────────────────────────────────────────────────────
# Unicorn Passport configuration. Copy to .env and fill in.
# In Azure, set these as App Service application settings
# (secrets as Key Vault references).
# ─────────────────────────────────────────────────────────────

# App
APP_URL=http://localhost:3000            # Public HTTPS URL in Azure, e.g. https://passport.unosquare.com
PROGRAM_NAME="Unicorn Passport"

# Database (local: `npm run db:local` starts Postgres on port 5433)
DATABASE_URL=postgresql://passport:passport@localhost:5433/unicorn_passport
TEST_DATABASE_URL=postgresql://passport:passport@localhost:5433/unicorn_passport_test   # used by npm test

# Auth.js
AUTH_SECRET=                             # `npx auth secret` or any 32+ random bytes, base64
AUTH_TRUST_HOST=true

# Microsoft Entra ID (single-tenant app registration)
AUTH_MICROSOFT_ENTRA_ID_ID=              # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=          # Client secret value
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=       # Directory (tenant) ID of Unosquare
ALLOWED_EMAIL_DOMAINS=unosquare.com      # Comma-separated; extra guard on top of single-tenant
ADMIN_APP_ROLE=Passport.Admin            # App role assigned to the admin security group (recommended)
ADMIN_GROUP_ID=                          # Optional: object ID of the admin security group (groups claim)

# Local development only: shows a "sign in as seed user" list. Ignored in production.
DEV_LOGIN=true
DEV_ADMIN_EMAILS=ana.admin@unosquare.com   # Dev login only: these seed users get admin

# Google Wallet (Milestone 3)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=unicorn_passport_v1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=      # PEM, with \n escaped

# Apple Wallet (Milestone 3)
APPLE_TEAM_ID=
APPLE_PASS_TYPE_ID=                      # e.g. pass.com.unosquare.unicornpassport
APPLE_PASS_CERT_PEM=                     # Pass Type ID certificate (PEM, \n escaped)
APPLE_PASS_KEY_PEM=                      # Its private key (PEM, \n escaped)
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PEM=                     # Apple WWDR G4 intermediate (PEM, \n escaped)
APPLE_APNS_KEY_ID=
APPLE_APNS_KEY_P8=                       # APNs auth key (.p8 contents, \n escaped)
APPLE_APNS_PRODUCTION=true               # Wallet passes always use the production APNs gateway
